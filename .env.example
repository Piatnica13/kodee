# Production template. For local development use scripts/local_db.py setup.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/kodee
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-password
APP_BASE_URL=https://kodee.kz
SESSION_COOKIE_SECURE=true
TRUSTED_HOSTS=kodee.kz,www.kodee.kz
# Empty = ignore all forwarded headers. Configure only the actual immediate proxy.
TRUSTED_PROXY_CIDRS=
PROXY_X_FOR=0
PROXY_X_PROTO=0
PROXY_X_HOST=0
PROXY_X_PORT=0
# Local Nginx: CIDR=127.0.0.1/32 and each hop count=1.
BOT_TOKEN=
BOT_ALLOWED_USER_IDS=
BOT_WEBHOOK_SECRET=
WEBHOOK_URL=https://kodee.kz/bot/webhook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PORT=5000
WEB_WORKERS=2
# Behind a host Nginx use 127.0.0.1:5000; inside Docker use 0.0.0.0:5000.
GUNICORN_BIND=127.0.0.1:5000
LOG_DIR=logs
# Render TLS-only ingress: set true and keep PROXY_X_PROTO=0.
PUBLIC_HTTPS=false
# Render persistent disk example: /var/data/productImgs
PRODUCT_IMAGES_DIR=
