# Host Nginx -> host Gunicorn at 127.0.0.1:5000.
# Install your TLS certificate first; replace domains/paths for another site.
server {
    listen 80;
    server_name kodee.kz www.kodee.kz;
    return 301 https://kodee.kz$request_uri;
}

server {
    listen 443 ssl;
    server_name kodee.kz www.kodee.kz;
    ssl_certificate /etc/letsencrypt/live/kodee.kz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kodee.kz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 34m;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        proxy_read_timeout 60s;
    }
}
